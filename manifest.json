    { name: "Zürich", timezone: "Europe/Zurich" }
];

staedte.sort((a, b) => a.name.localeCompare(b.name, "de"));

// FAVORITEN MANAGEMENT
const FAVORITEN_KEY = "timeShiftFavoriten";

function favoritenLaden() {
    try {
        const gespeichert = localStorage.getItem(FAVORITEN_KEY);
        if (!gespeichert) return [];
        const daten = JSON.parse(gespeichert);
        return Array.isArray(daten) ? daten : [];
    } catch (e) {
        return [];
    }
}

function favoritenSpeichern(liste) {
    try {
        localStorage.setItem(FAVORITEN_KEY, JSON.stringify(liste));
    } catch (e) {}
}

let favoriten = favoritenLaden();

function istFavorit(stadt) { return favoriten.includes(stadt.name); }

function favoritHinzufuegen(stadt) {
    if (!istFavorit(stadt)) {
        favoriten.push(stadt.name);
        favoritenSpeichern(favoriten);
    }
}

function favoritLoeschen(stadt) {
    favoriten = favoriten.filter(name => name !== stadt.name);
    favoritenSpeichern(favoriten);
}

// ZIFFERBLATT RENDERN (BEIM LADEN & FENSTER-RESIZE)
function renderClockFace() {
    const tickContainer = document.getElementById('tickContainer');
    const numbersContainer = document.getElementById('numbersContainer');
    const clock = document.getElementById('clock');
    
    tickContainer.innerHTML = '';
    numbersContainer.innerHTML = '';

    // 1. Striche
    for (let i = 0; i < 60; i++) {
        const tick = document.createElement('div');
        tick.className = i % 5 === 0 ? 'tick major' : 'tick minor';
        tick.style.transform = `rotate(${i * 6}deg)`;
        tickContainer.appendChild(tick);
    }

    // 2. Zahlen Mathematik-basiert exakt unter den Stundenstrichen platzieren
    const clockSize = clock.clientWidth;
    const centerX = clockSize / 2;
    const centerY = clockSize / 2;
    // Dynamischer Radius basierend auf der aktuellen Uhrgröße
    const radius = clockSize * 0.355; 

    for (let i = 1; i <= 12; i++) {
        const num = document.createElement('div');
        num.className = 'number';
        num.textContent = i;
        
        const angleRad = ((i * 30) - 90) * (Math.PI / 180);
        const x = centerX + radius * Math.cos(angleRad);
        const y = centerY + radius * Math.sin(angleRad);

        num.style.left = `${x}px`;
        num.style.top = `${y}px`;
        numbersContainer.appendChild(num);
    }
}

renderClockFace();
window.addEventListener('resize', renderClockFace);

// VARIABLEN FÜR LOGIK
let startzeit = null;
let startZeitzone = null;
let zielZeitzone = null;
let startStadt = null;
let zielStadt = null;
let startOrtszeit = null;
let zeitverschiebung = null;
let gesamtFlugzeit = null;
let timer = null;

// ELEMENTE REFERENZEN
const startSearch = document.getElementById("startSearch");
const destinationSearch = document.getElementById("destinationSearch");
const startResults = document.getElementById("startResults");
const destinationResults = document.getElementById("destinationResults");
const flightDurationInput = document.getElementById("flightDurationInput");
const secondHand = document.getElementById("secondHand");
const startButton = document.getElementById("startButton");
const cancelButton = document.getElementById("cancelButton");
const errorMessage = document.getElementById("errorMessage");
const dialogBackground = document.getElementById("dialogBackground");
const dialogCancel = document.getElementById("dialogCancel");
const dialogConfirm = document.getElementById("dialogConfirm");

// FLUGZEIT EINGABE-LOGIK
let flugzeitZiffern = "";

function flugzeitFormatieren(ziffern) {
    ziffern = String(ziffern).replace(/\D/g, "").slice(0, 4);
    if (ziffern.length === 0) return "00:00";
    const zahl = Number(ziffern);
    const minuten = zahl % 100;
    const stunden = Math.floor(zahl / 100);
    return zweiStellen(stunden) + ":" + zweiStellen(minuten);
}

function flugzeitAktualisieren() {
    flightDurationInput.value = flugzeitFormatieren(flugzeitZiffern);
}

flightDurationInput.addEventListener("focus", function() {
    setTimeout(function() {
        flightDurationInput.setSelectionRange(
            flightDurationInput.value.length,
            flightDurationInput.value.length
        );
    }, 0);
});

flightDurationInput.addEventListener("keydown", function(event) {
    if (event.key >= "0" && event.key <= "9") {
        event.preventDefault();
        if (flugzeitZiffern.length < 4) {
            flugzeitZiffern += event.key;
            flugzeitAktualisieren();
        }
        return;
    }
    if (event.key === "Backspace" || event.key === "Delete") {
        event.preventDefault();
        flugzeitZiffern = flugzeitZiffern.slice(0, -1);
        flugzeitAktualisieren();
        return;
    }
    if (event.key === "Tab" || event.key === "ArrowLeft" || event.key === "ArrowRight" || event.key === "Home" || event.key === "End") return;
    if (event.ctrlKey || event.metaKey) return;
    event.preventDefault();
});

// =====================================================
// UHR-AUSWAHL DROPDOWN LOGIK
// =====================================================
const clockSelectorButton = document.getElementById("clockSelectorButton");
const clockSelectorMenu = document.getElementById("clockSelectorMenu");
const clockOptions = document.querySelectorAll(".clock-option");

// Menü öffnen/schließen
clockSelectorButton.addEventListener("click", function(event) {
    event.stopPropagation();
    clockSelectorMenu.classList.toggle("open");
});

// Eine Option auswählen
clockOptions.forEach(option => {
    option.addEventListener("click", function(event) {
        event.stopPropagation();
        const value = option.dataset.value;
        const iconHtml = option.innerHTML; // Das grafische Icon kopieren

        // Sekundenzeiger an/aus
        if (value === "withSeconds") {
            secondHand.style.display = "block";
            clockSelectorButton.dataset.mode = "withSeconds";
        } else {
            secondHand.style.display = "none";
            clockSelectorButton.dataset.mode = "withoutSeconds";
        }
        
        // Das Icon auf dem Haupt-Button aktualisieren
        clockSelectorButton.innerHTML = iconHtml + '<span class="dropdown-arrow">▼</span>';
        
        // Menü schließen
        clockSelectorMenu.classList.remove("open");
    });
});

// Schließen beim Klick außerhalb
document.addEventListener("click", function() {
    clockSelectorMenu.classList.remove("open");
});

// STÄDTE-SUCHE & ERGEBNISSE
function suche(eingabe) {
    const text = eingabe.trim().toLocaleLowerCase("de");
    if (text === "") return staedte.slice();
    return staedte.filter(stadt => stadt.name.toLocaleLowerCase("de").startsWith(text));
}

function ergebnisseAnzeigen(input, container, ziel) {
    const treffer = suche(input.value);
    container.innerHTML = "";
    const favs = treffer.filter(stadt => istFavorit(stadt));
    const normale = treffer.filter(stadt => !istFavorit(stadt));

    if (favs.length > 0) {
        const titel = document.createElement("div");
        titel.className = "favorite-title";
        titel.textContent = "⭐ FAVORITEN";
        container.appendChild(titel);
    }

    favs.forEach(stadt => {
        container.appendChild(erstelleErgebnis(stadt, ziel, true, input, container));
    });

    normale.slice(0, 8).forEach(stadt => {
        container.appendChild(erstelleErgebnis(stadt, ziel, false, input, container));
    });

    if (container.children.length === 0) {
        container.style.display = "none";
        return;
    }
    container.style.display = "block";
}

function erstelleErgebnis(stadt, ziel, favorit, input, container) {
    const element = document.createElement("div");
    element.className = "result";

    const cityName = document.createElement("div");
    cityName.className = "city-name";
    cityName.textContent = stadt.name;

    cityName.addEventListener("click", function() {
        input.value = stadt.name;
        container.style.display = "none";
        if (ziel === "start") {
            startStadt = stadt.name;
            startZeitzone = stadt.timezone;
            document.getElementById("startCity").textContent = startStadt;
        } else {
            zielStadt = stadt.name;
            zielZeitzone = stadt.timezone;
            document.getElementById("destinationCity").textContent = zielStadt;
        }
    });

    element.appendChild(cityName);

    if (favorit) {
        const button = document.createElement("button");
        button.className = "delete-favorite-button";
        button.textContent = "🗑️";
        button.title = "Favorit löschen";
        button.addEventListener("click", function(event) {
            event.stopPropagation();
            favoritLoeschen(stadt);
            ergebnisseAnzeigen(input, container, ziel);
        });
        element.appendChild(button);
    } else {
        const button = document.createElement("button");
        button.className = "favorite-button";
        button.textContent = "☆";
        button.title = "Zu Favoriten hinzufügen";
        button.addEventListener("click", function(event) {
            event.stopPropagation();
            favoritHinzufuegen(stadt);
            ergebnisseAnzeigen(input, container, ziel);
        });
        element.appendChild(button);
    }
    return element;
}

startSearch.addEventListener("focus", function() { ergebnisseAnzeigen(startSearch, startResults, "start"); });
startSearch.addEventListener("input", function() {
    startStadt = null; startZeitzone = null;
    document.getElementById("startCity").textContent = "—";
    ergebnisseAnzeigen(startSearch, startResults, "start");
});

destinationSearch.addEventListener("focus", function() { ergebnisseAnzeigen(destinationSearch, destinationResults, "destination"); });
destinationSearch.addEventListener("input", function() {
    zielStadt = null; zielZeitzone = null;
    document.getElementById("destinationCity").textContent = "—";
    ergebnisseAnzeigen(destinationSearch, destinationResults, "destination");
});

document.addEventListener("click", function(event) {
    if (!startSearch.contains(event.target) && !startResults.contains(event.target)) {
        startResults.style.display = "none";
    }
    if (!destinationSearch.contains(event.target) && !destinationResults.contains(event.target)) {
        destinationResults.style.display = "none";
    }
});

// BERECHNUNGS-LOGIK
function flugzeitAuslesen() {
    if (flugzeitZiffern === "") return null;
    const zahl = Number(flugzeitZiffern);
    const minuten = zahl % 100;
    const stunden = Math.floor(zahl / 100);
    if (minuten >= 60) return null;
    const gesamt = stunden * 60 + minuten;
    if (gesamt <= 0) return null;
    return gesamt;
}

startButton.addEventListener("click", function() {
    errorMessage.textContent = "";
    if (!startStadt || !startZeitzone) {
        errorMessage.textContent = "Bitte einen Abflugort auswählen.";
        return;
    }
    if (!zielStadt || !zielZeitzone) {
        errorMessage.textContent = "Bitte einen Zielort auswählen.";
        return;
    }
    const flugzeit = flugzeitAuslesen();
    if (flugzeit === null) {
        errorMessage.textContent = "Bitte eine gültige Flugzeit eingeben.";
        return;
    }

    gesamtFlugzeit = flugzeit;
    startzeit = new Date();
    startOrtszeit = minutenSeitMitternacht(startzeit, startZeitzone);

    const startOffset = zeitzonenOffset(startzeit, startZeitzone);
    const zielOffset = zeitzonenOffset(startzeit, zielZeitzone);
    zeitverschiebung = (zielOffset - startOffset) / 60000;

    startSearch.disabled = true;
    destinationSearch.disabled = true;
    flightDurationInput.disabled = true;

    startButton.textContent = "Flug läuft …";
    startButton.disabled = true;
    cancelButton.style.display = "inline-block";

    ankunftAnzeigen();

    if (timer !== null) clearInterval(timer);
    timer = setInterval(berechnen, 100);
    berechnen();
});

cancelButton.addEventListener("click", function() { dialogBackground.style.display = "flex"; });
dialogCancel.addEventListener("click", function() { dialogBackground.style.display = "none"; });
dialogConfirm.addEventListener("click", function() {
    dialogBackground.style.display = "none";
    flugZuruecksetzen();
});

function berechnen() {
    if (startzeit === null || gesamtFlugzeit === null) return;
    let vergangen = (Date.now() - startzeit.getTime()) / 60000;

    if (vergangen >= gesamtFlugzeit) {
        vergangen = gesamtFlugzeit;
        clearInterval(timer);
        timer = null;
    }

    const beschleunigungsfaktor = 1 + (zeitverschiebung / gesamtFlugzeit);
    let theoretischeZeit = startOrtszeit + (vergangen * beschleunigungsfaktor);
    theoretischeZeit = normalisiereMinuten(theoretischeZeit);

    const stunden = theoretischeZeit / 60;
    const minuten = theoretischeZeit % 60;
    const sekunden = (theoretischeZeit * 60) % 60;

    const stundenWinkel = (stunden % 12) * 30;
    const minutenWinkel = minuten * 6;
    const sekundenWinkel = sekunden * 6;

    document.getElementById("hourHand").style.transform = `rotate(${stundenWinkel}deg)`;
    document.getElementById("minuteHand").style.transform = `rotate(${minutenWinkel}deg)`;
    document.getElementById("secondHand").style.transform = `rotate(${sekundenWinkel}deg)`;

    aktualisiereOrtszeiten();

    document.getElementById("elapsed").textContent = dauerFormatieren(vergangen);
    document.getElementById("remaining").textContent = dauerFormatieren(Math.max(0, gesamtFlugzeit - vergangen));
}

function ankunftAnzeigen() {
    if (!startzeit || !zielZeitzone || !gesamtFlugzeit) return;
    const ankunft = new Date(startzeit.getTime() + gesamtFlugzeit * 60000);

    const datumFormatter = new Intl.DateTimeFormat("de-DE", {
        timeZone: zielZeitzone,
        weekday: "long",
        day: "2-digit",
        month: "long",
        year: "numeric"
    });

    const zeitFormatter = new Intl.DateTimeFormat("de-DE", {
        timeZone: zielZeitzone,
        hour: "2-digit",
        minute: "2-digit",
        hourCycle: "h23"
    });

    document.getElementById("arrivalCity").textContent = zielStadt;
    document.getElementById("arrivalDate").textContent = datumFormatter.format(ankunft);
    document.getElementById("arrivalTime").textContent = zeitFormatter.format(ankunft);
}

function aktualisiereOrtszeiten() {
    if (!startZeitzone || !zielZeitzone) return;
    const jetzt = new Date();
    document.getElementById("startTime").textContent = uhrzeitInZeitzone(jetzt, startZeitzone);
    document.getElementById("destinationTime").textContent = uhrzeitInZeitzone(jetzt, zielZeitzone);
}

function uhrzeitInZeitzone(datum, zeitzone) {
    return new Intl.DateTimeFormat("de-DE", {
        timeZone: zeitzone,
        hour: "2-digit",
        minute: "2-digit",
        hourCycle: "h23"
    }).format(datum);
}

function minutenSeitMitternacht(datum, zeitzone) {
    const teile = new Intl.DateTimeFormat("de-DE", {
        timeZone: zeitzone,
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit",
        hourCycle: "h23"
    }).formatToParts(datum);

    let stunde = 0, minute = 0, sekunde = 0;
    for (const teil of teile) {
        if (teil.type === "hour") stunde = Number(teil.value);
        if (teil.type === "minute") minute = Number(teil.value);
        if (teil.type === "second") sekunde = Number(teil.value);
    }
    return stunde * 60 + minute + sekunde / 60;
}

function zeitzonenOffset(datum, zeitzone) {
    const teile = new Intl.DateTimeFormat("en-US", {
        timeZone: zeitzone,
        year: "numeric", month: "2-digit", day: "2-digit",
        hour: "2-digit", minute: "2-digit", second: "2-digit",
        hourCycle: "h23"
    }).formatToParts(datum);

    const werte = {};
    for (const teil of teile) {
        if (teil.type !== "literal") werte[teil.type] = Number(teil.value);
    }

    const lokaleZeit = Date.UTC(werte.year, werte.month - 1, werte.day, werte.hour, werte.minute, werte.second);
    return lokaleZeit - datum.getTime();
}

// ZURÜCKSETZEN-LOGIK
function uhrZuruecksetzen() {
    document.getElementById("hourHand").style.transform = "rotate(0deg)";
    document.getElementById("minuteHand").style.transform = "rotate(0deg)";
    document.getElementById("secondHand").style.transform = "rotate(0deg)";
    
    // Nur den Sekundenzeiger ausblenden, wenn die Einstellung "ohne Sekunden" aktiv ist
    if (clockSelectorButton.dataset.mode !== "withSeconds") {
        secondHand.style.display = "none";
    }
}

function normalisiereMinuten(minuten) {
    minuten = minuten % (24 * 60);
    if (minuten < 0) minuten += 24 * 60;
    return minuten;
}

function dauerFormatieren(minuten) {
    const stunden = Math.floor(minuten / 60);
    const rest = Math.floor(minuten % 60);
    return zweiStellen(stunden) + ":" + zweiStellen(rest);
}

function zweiStellen(zahl) {
    return String(Math.floor(zahl)).padStart(2, "0");
}


// =====================================================
// 2. FLUGZUSTAND SPEICHERN & WIEDERHERSTELLEN
// =====================================================
const FLIGHT_STORAGE_KEY = "timeShift_active_flight";

// Speichert den aktuellen Flug im Speicher des Geräts
function flugSpeichern() {
  if (!startzeit) return;
  const daten = {
    startzeit: startzeit.getTime(),
    startStadt,
    startZeitzone,
    zielStadt,
    zielZeitzone,
    flugzeitZiffern,
    gesamtFlugzeit
  };
  localStorage.setItem(FLIGHT_STORAGE_KEY, JSON.stringify(daten));
}

// Stells den Flug nach App-Schließen/Neustart wieder her
function flugWiederherstellen() {
  const gespeichert = localStorage.getItem(FLIGHT_STORAGE_KEY);
  if (!gespeichert) return;

  try {
    const daten = JSON.parse(gespeichert);
    
    // Daten zurückschreiben
    startzeit = new Date(daten.startzeit);
    startStadt = daten.startStadt;
    startZeitzone = daten.startZeitzone;
    zielStadt = daten.zielStadt;
    zielZeitzone = daten.zielZeitzone;
    flugzeitZiffern = daten.flugzeitZiffern;
    gesamtFlugzeit = daten.gesamtFlugzeit;

    // UI-Elemente wieder befüllen
    startSearch.value = startStadt;
    destinationSearch.value = zielStadt;
    document.getElementById("startCity").textContent = startStadt;
    document.getElementById("destinationCity").textContent = zielStadt;
    flightDurationInput.value = flugzeitFormatieren(flugzeitZiffern);

    // Mathematik neu anstoßen
    startOrtszeit = minutenSeitMitternacht(startzeit, startZeitzone);
    const startOffset = zeitzonenOffset(startzeit, startZeitzone);
    const zielOffset = zeitzonenOffset(startzeit, zielZeitzone);
    zeitverschiebung = (zielOffset - startOffset) / 60000;

    // Inputs sperren & Flug-Modus aktivieren
    startSearch.disabled = true;
    destinationSearch.disabled = true;
    flightDurationInput.disabled = true;
    startButton.textContent = "Flug läuft …";
    startButton.disabled = true;
    cancelButton.style.display = "inline-block";

    ankunftAnzeigen();

    if (timer !== null) clearInterval(timer);
    timer = setInterval(berechnen, 100);
    berechnen();
  } catch (e) {
    console.error("Fehler beim Wiederherstellen des Fluges", e);
  }
}

function flugZuruecksetzen() {
    if (timer !== null) { clearInterval(timer); timer = null; }
    startzeit = null; startZeitzone = null; zielZeitzone = null;
    startStadt = null; zielStadt = null;
    startOrtszeit = null; zeitverschiebung = null; gesamtFlugzeit = null;
    flugzeitZiffern = "";

    startSearch.value = "";
    destinationSearch.value = "";
    flugzeitAktualisieren();

    startSearch.disabled = false;
    destinationSearch.disabled = false;
    flightDurationInput.disabled = false;

    document.getElementById("startCity").textContent = "—";
    document.getElementById("destinationCity").textContent = "—";
    document.getElementById("startTime").textContent = "--:--";
    document.getElementById("destinationTime").textContent = "--:--";
    document.getElementById("elapsed").textContent = "00:00";
    document.getElementById("remaining").textContent = "--:--";
    document.getElementById("arrivalCity").textContent = "—";
    document.getElementById("arrivalDate").textContent = "—";
    document.getElementById("arrivalTime").textContent = "--:--";
    errorMessage.textContent = "";

    startButton.textContent = "Flug starten";
    startButton.disabled = false;
    cancelButton.style.display = "none";

    uhrZuruecksetzen();

    // Speicherung leeren
    localStorage.removeItem(FLIGHT_STORAGE_KEY);
}

// Trigger für Speicherung
startButton.addEventListener("click", function() {
  setTimeout(flugSpeichern, 50);
});

// Beim Laden prüfen
window.addEventListener("DOMContentLoaded", flugWiederherstellen);

</script>

