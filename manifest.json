<!DOCTYPE html>
<html lang="de">

<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>TimeShift</title>

<!-- --- ICON & PWA EINSTELLUNGEN --- -->
<link rel="icon" type="image/png" href="icon.png">
<link rel="apple-touch-icon" href="icon.png">
<link rel="manifest" href="manifest.json">
<meta name="theme-color" content="#111111">

<style>

* {
    box-sizing: border-box;
}

html, body {
    height: 100%;
    margin: 0;
    padding: 0;
    overflow: hidden;
}

body {
    background: #111;
    color: white;
    font-family: -apple-system, BlinkMacSystemFont, Arial, sans-serif;
    text-align: center;
}

.app {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    max-height: 100dvh;
    padding: 15px 12px 20px;
}


/* =====================================================
   KOPFZEILE
   ===================================================== */

.app-header {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-bottom: 10px;
}

.app-header h1 {
    font-size: 24px;
    margin: 0;
}


/* =====================================================
   UHR-AUSWAHL (DROPDOWN MIT GRAFISCHEN SYMBOLEN)
   ===================================================== */

.clock-selector {
    position: relative;
}

#clockSelectorButton {
    margin: 0;
    padding: 5px 8px;
    font-size: 14px;
    border: none;
    border-radius: 8px;
    background: #222;
    color: white;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 5px;
}

.dropdown-arrow {
    font-size: 10px;
    opacity: 0.6;
}

.clock-selector-menu {
    display: none;
    position: absolute;
    top: calc(100% + 5px);
    right: 0;
    min-width: 80px;
    background: #222;
    border-radius: 10px;
    overflow: hidden;
    z-index: 100;
    box-shadow: 0 8px 25px rgba(0,0,0,0.5);
}

.clock-selector-menu.open {
    display: block;
}

.clock-option {
    padding: 12px;
    text-align: center;
    cursor: pointer;
    transition: background 0.2s;
    display: flex;
    justify-content: center;
    align-items: center;
}

.clock-option:active,
.clock-option:hover {
    background: #333;
}

.clock-icon {
    width: 28px;
    height: 28px;
    border: 2px solid white;
    border-radius: 50%;
    position: relative;
    box-shadow: 0 0 5px rgba(255,255,255,0.2);
}

.clock-icon::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 2px;
    height: 6px;
    background: white;
    transform: translate(-100%, -100%) rotate(-45deg);
    transform-origin: bottom center;
}

.clock-icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 1.5px;
    height: 10px;
    background: white;
    transform: translate(-100%, -100%) rotate(30deg);
    transform-origin: bottom center;
}

.icon-red-hand {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 1px;
    height: 12px;
    background: #d32f2f;
    transform: translate(-100%, -100%) rotate(135deg);
    transform-origin: bottom center;
    z-index: 3;
}

.clock-icon .icon-center {
    width: 3px;
    height: 3px;
    background: white;
    border-radius: 50%;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 5;
}


/* =====================================================
   RESTLICHE UI
   ===================================================== */

/* START / ZIEL SUCHE */
.selection {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    gap: 8px;
    margin-bottom: 10px;
}

.selection-group {
    width: 160px;
    position: relative;
}

.selection label {
    display: block;
    color: #aaa;
    font-size: 12px;
    margin-bottom: 4px;
}

.search-input {
    width: 100%;
    padding: 8px;
    font-size: 15px;
    border: none;
    border-radius: 10px;
    background: #222;
    color: white;
    outline: none;
    text-align: center;
}

.search-input:focus { background: #292929; }
.search-input::placeholder { color: #777; }

.arrow { font-size: 20px; margin-top: 24px; }

.results {
    position: absolute;
    top: 55px;
    left: 0;
    width: 100%;
    max-height: 200px;
    overflow-y: auto;
    background: #222;
    border-radius: 12px;
    z-index: 50;
    display: none;
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
}

.result {
    min-height: 40px;
    padding: 5px 6px;
    border-bottom: 1px solid #333;
    font-size: 14px;
    display: flex;
    align-items: center;
    gap: 5px;
}

.result:last-child { border-bottom: none; }

.city-name {
    flex: 1;
    cursor: pointer;
    text-align: left;
    padding-left: 5px;
}

.favorite-button,
.delete-favorite-button {
    width: 32px;
    height: 32px;
    margin: 0;
    padding: 0;
    border: none;
    border-radius: 8px;
    background: transparent;
    color: white;
    cursor: pointer;
}

.favorite-button { font-size: 18px; }
.delete-favorite-button { font-size: 15px; }
.favorite-button:active,
.delete-favorite-button:active { background: #444; }

.favorite-title {
    padding: 8px 8px 5px;
    color: #aaa;
    font-size: 11px;
    text-align: left;
    border-bottom: 1px solid #333;
}

/* FLUGZEIT EINGABE */
.flight-duration {
    margin-bottom: 10px;
}

.flight-duration label {
    display: block;
    color: #aaa;
    font-size: 12px;
    margin-bottom: 4px;
}

.duration-input-wrapper {
    display: flex;
    justify-content: center;
}

#flightDurationInput {
    width: 120px;
    padding: 6px 8px;
    font-family: "Courier New", monospace;
    font-size: 20px;
    font-weight: 600;
    border: none;
    border-radius: 10px;
    background: #222;
    color: white;
    outline: none;
    text-align: center;
    letter-spacing: 1px;
}

#flightDurationInput::placeholder { color: #666; opacity: 1; }
#flightDurationInput:focus { background: #292929; }
#flightDurationInput:disabled { opacity: 0.5; }

/* UHREN-BEREICH */
.clocks-area {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-bottom: 5px;
}

.local-clock {
    width: 75px;
}

.local-time {
    font-family: "Courier New", monospace;
    font-size: 16px;
    font-weight: 600;
    white-space: nowrap;
}

.local-city {
    margin-top: 4px;
    font-size: 12px;
    color: #aaa;
}

.clock {
    width: 220px;
    height: 220px;
    background: white;
    border: 6px solid #222;
    border-radius: 50%;
    position: relative;
    flex-shrink: 0;
    box-shadow: 0 6px 20px rgba(0,0,0,0.4);
}

.tick-container {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
}

.tick {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 0;
    transform-origin: center center;
}

.tick.minor::after {
    content: '';
    position: absolute;
    top: 3px;
    left: -0.6px;
    width: 1.2px;
    height: 6px;
    background: #111;
}

.tick.major::after {
    content: '';
    position: absolute;
    top: 3px;
    left: -1.5px;
    width: 3px;
    height: 10px;
    background: #111;
}

.number {
    position: absolute;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 20px;
    font-weight: bold;
    color: #111;
    text-align: center;
    width: 30px;
    height: 30px;
    line-height: 30px;
    margin-left: -15px;
    margin-top: -15px;
    z-index: 5;
}

.center {
    width: 12px;
    height: 12px;
    background: #111;
    border-radius: 50%;
    position: absolute;
    left: 50%; 
    top: 50%;
    transform: translate(-50%, -50%);
    z-index: 10;
}

.hand {
    position: absolute;
    left: 50%;
    bottom: 50%;
    transform-origin: bottom center;
    background: #111;
    border-radius: 2px;
    z-index: 8;
}

.hour-hand {
    width: 4.5px;
    height: 52px;
    margin-left: -2.25px;
}

.minute-hand {
    width: 3px;
    height: 86px;
    margin-left: -1.5px;
}

.second-hand {
    width: 1.5px;
    height: 92px;
    margin-left: -0.75px;
    background: #d32f2f;
    z-index: 9;
}

/* FLUGFORTSCHRITT & ANKUNFT */
.flight-status {
    width: 100%;
    max-width: 420px;
    margin: 5px auto 0;
    padding: 10px 12px 8px;
    background: #1d1d1d;
    border-radius: 12px;
    border: 1px solid #333;
}

.flight-status-title {
    color: #aaa;
    font-size: 11px;
    letter-spacing: 1px;
    margin-bottom: 8px;
}

.flight-times {
    display: flex;
    justify-content: center; /* HIER WAR DER FEHLER: justify(content -> justify-content */
    align-items: center;
}

.flight-time-block { flex: 1; }

.flight-time-label {
    display: block;
    color: #888;
    font-size: 11px;
    margin-bottom: 2px;
}

.flight-time-value {
    display: block;
    font-family: "Courier New", monospace;
    font-size: 20px;
    font-weight: 600;
    letter-spacing: 1px;
}

.flight-time-divider {
    width: 1px;
    height: 30px;
    background: #444;
    margin: 0 10px;
}

.arrival {
    margin-top: 8px;
    padding-top: 8px;
    border-top: 1px solid #333;
}

.arrival-title {
    color: #aaa;
    font-size: 11px;
    letter-spacing: 1px;
    margin-bottom: 4px;
}

.arrival-city {
    font-size: 15px;
    font-weight: 600;
    margin-bottom: 2px;
}

.arrival-date {
    font-size: 13px;
    color: #ccc;
    line-height: 1.2;
}

.arrival-time {
    font-family: "Courier New", monospace;
    font-size: 18px;
    font-weight: 600;
    margin-top: 2px;
}

/* FEHLER & BUTTONS */
#errorMessage {
    min-height: 18px;
    margin-top: 4px;
    color: #ff6b6b;
    font-size: 12px;
}

.button-area { margin-top: 5px; }

button {
    margin-top: 0;
    padding: 10px 20px;
    font-size: 16px;
    border: none;
    border-radius: 10px;
    background: white;
    color: black;
}

button:disabled { opacity: 0.5; }

#cancelButton {
    display: none;
    margin-left: 8px;
    background: #333;
    color: white;
}

/* DIALOG & RESPONSIVE DESIGN */
.dialog-background {
    display: none;
    position: fixed;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.75);
    align-items: center;
    justify-content: center;
    z-index: 100;
}

.dialog {
    width: 80%;
    max-width: 350px;
    background: #222;
    border-radius: 20px;
    padding: 20px;
}

.dialog h2 { margin-top: 0; font-size: 18px; }
.dialog p { color: #aaa; font-size: 13px; line-height: 1.4; }
.dialog button { width: 100%; margin-left: 0; margin-top: 8px; }

.confirm-cancel { background: #444; color: white; }
.confirm-stop { background: #c00; color: white; }

@media (max-height: 700px), (max-width: 600px) {
    .app { padding: 8px 8px 12px; }
    .app-header { margin-bottom: 6px; }
    .app-header h1 { font-size: 20px; }
    .selection { gap: 4px; margin-bottom: 6px; }
    .selection-group { width: 130px; }
    .search-input { font-size: 13px; padding: 6px; }
    .arrow { font-size: 16px; margin-top: 20px; }
    .flight-duration { margin-bottom: 6px; }

    #flightDurationInput {
        width: 100px;
        font-size: 18px;
        padding: 4px 6px;
    }

    .clock {
        width: 160px;
        height: 160px;
        border-width: 4px;
    }

    .tick.minor::after { top: 2px; height: 4px; }
    .tick.major::after { top: 2px; height: 7px; width: 2px; left: -1px; }

    .number {
        font-size: 14px;
        width: 20px;
        height: 20px;
        line-height: 20px;
        margin-left: -10px;
        margin-top: -10px;
    }

    .center {
        width: 9px;
        height: 9px;
    }

    .hour-hand { height: 38px; width: 3.5px; margin-left: -1.75px; }
    .minute-hand { height: 62px; width: 2.5px; margin-left: -1.25px; }
    .second-hand { height: 68px; }

    .local-clock { width: 60px; }
    .local-time { font-size: 13px; }
    .local-city { font-size: 10px; }

    .flight-status { padding: 8px; margin-top: 2px; }
    .flight-time-value { font-size: 17px; }
    .arrival { margin-top: 4px; padding-top: 4px; }
    .arrival-city { font-size: 13px; }
    .arrival-date { font-size: 11px; }
    .arrival-time { font-size: 15px; }

    button { padding: 8px 16px; font-size: 14px; }
    
    .clock-icon {
        width: 20px;
        height: 20px;
        border-width: 1.5px;
    }
    
    .clock-icon::before { height: 4px; width: 1.5px; }
    .clock-icon::after { height: 7px; width: 1px; }
    .icon-red-hand { height: 8px; width: 1px; }
    .clock-icon .icon-center { width: 2px; height: 2px; }
    
    #clockSelectorButton { gap: 3px; padding: 4px 6px; }
    .clock-option { padding: 8px; }
}

</style>
</head>


<body>

<div class="app">

<!-- KOPFZEILE -->
<div class="app-header">
    <h1>✈️ TimeShift</h1>
    
    <!-- UHR-AUSWAHL DROPDOWN -->
    <div class="clock-selector">
        
        <!-- data-mode speichert, welcher Stil aktiv ist, um Resets besser zu handhaben -->
        <button id="clockSelectorButton" data-mode="withoutSeconds" type="button" aria-label="Uhrdarstellung wechseln">
            <div class="clock-icon minor-mode">
                <div class="icon-center"></div>
            </div>
            <span class="dropdown-arrow">▼</span>
        </button>
        
        <div id="clockSelectorMenu" class="clock-selector-menu">
            <!-- Option 1: Ohne Sekunden -->
            <div class="clock-option" data-value="withoutSeconds" title="Ohne Sekunden">
                <div class="clock-icon minor-mode">
                    <div class="icon-center"></div>
                </div>
            </div>
            
            <!-- Option 2: Mit Sekunden -->
            <div class="clock-option" data-value="withSeconds" title="Mit Sekunden">
                <div class="clock-icon major-mode">
                    <div class="icon-red-hand"></div>
                    <div class="icon-center"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- START / ZIEL SUCHE -->
<div class="selection">
    <div class="selection-group">
        <label>Abflugort</label>
        <input id="startSearch" class="search-input" type="text" placeholder="Ort suchen" autocomplete="off">
        <div id="startResults" class="results"></div>
    </div>
    <div class="arrow">→</div>
    <div class="selection-group">
        <label>Zielort</label>
        <input id="destinationSearch" class="search-input" type="text" placeholder="Ort suchen" autocomplete="off">
        <div id="destinationResults" class="results"></div>
    </div>
</div>

<!-- FLUGZEIT EINGABE -->
<div class="flight-duration">
    <label>Flugzeit</label>
    <div class="duration-input-wrapper">
        <input id="flightDurationInput" type="text" inputmode="numeric" pattern="[0-9]*" autocomplete="off" placeholder="00:00" aria-label="Flugzeit">
    </div>
</div>

<!-- UHREN-BEREICH -->
<div class="clocks-area">
    <div class="local-clock">
        <div id="startTime" class="local-time">--:--</div>
        <div id="startCity" class="local-city">—</div>
    </div>

    <!-- Analoguhr -->
    <div class="clock" id="clock">
        <div class="tick-container" id="tickContainer"></div>
        <div id="numbersContainer"></div>

        <div id="hourHand" class="hand hour-hand"></div>
        <div id="minuteHand" class="hand minute-hand"></div>
        <div id="secondHand" class="hand second-hand" style="display:none;"></div>
        <div class="center"></div>
    </div>

    <div class="local-clock">
        <div id="destinationTime" class="local-time">--:--</div>
        <div id="destinationCity" class="local-city">—</div>
    </div>
</div>

<!-- FLUGFORTSCHRITT & ANKUNFT -->
<div class="flight-status">
    <div class="flight-status-title">FLUGFORTSCHRITT</div>
    <div class="flight-times">
        <div class="flight-time-block">
            <span class="flight-time-label">Vergangen</span>
            <span id="elapsed" class="flight-time-value">00:00</span>
        </div>
        <div class="flight-time-divider"></div>
        <div class="flight-time-block">
            <span class="flight-time-label">Verbleibend</span>
            <span id="remaining" class="flight-time-value">--:--</span>
        </div>
    </div>

    <div class="arrival">
        <div class="arrival-title">ANKUNFT</div>
        <div id="arrivalCity" class="arrival-city">—</div>
        <div id="arrivalDate" class="arrival-date">—</div>
        <div id="arrivalTime" class="arrival-time">--:--</div>
    </div>
</div>

<div id="errorMessage"></div>

<div class="button-area">
    <button id="startButton">Flug starten</button>
    <button id="cancelButton">Flug abbrechen</button>
</div>

</div>

<!-- SICHERHEITSABFRAGE DIALOG -->
<div id="dialogBackground" class="dialog-background">
    <div class="dialog">
        <h2>Flug abbrechen?</h2>
        <p>Möchtest du den aktuellen Flug wirklich abbrechen?</p>
        <p>Der bisherige Flugfortschritt geht verloren.</p>
        <button id="dialogCancel" class="confirm-cancel">Weiterfliegen</button>
        <button id="dialogConfirm" class="confirm-stop">Flug abbrechen</button>
    </div>
</div>

<script>

// =====================================================
// 1. OFFLINE-SERVICE-WORKER REGISTRIEREN
// =====================================================
if ('serviceWorker' in navigator) {
  window.addEventListener('load', () => {
    navigator.serviceWorker.register('./sw.js')
      .then(reg => console.log('Service Worker registriert'))
      .catch(err => console.log('Service Worker Fehler', err));
  });
}


